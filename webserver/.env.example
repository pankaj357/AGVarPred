# Backend deployment settings. Keep live prediction off until provider terms are reviewed.
AGVARPRED_ENABLE_LIVE_PREDICTION=false
AGVARPRED_ALPHA_TERMS_REVIEWED=false

# Preferred: reduced tabix-indexed AF+VEP TSV generated inside the website clone.
# GNOMAD_TSV=/data/kanaka/pankaj/AGVarPred-webserver/data/gnomad/gnomad.exomes.r2.1.1.sites.liftover_grch38.af_vep.tsv.gz

# Fallback: full local gnomAD VCF (kept untouched as a backup source).
# GNOMAD_VCF=/data/kanaka/pankaj/Raw_Dataset/gnomAD/gnomad.exomes.r2.1.1.sites.liftover_grch38.vcf.bgz

# Set these only through a local untracked .env or deployment secret manager.
# ALPHAGENOME_API_KEY=

# Comma-separated allowed frontend origins. Configure production origins explicitly.
AGVARPRED_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
