# Backend deployment settings. Keep live prediction off until provider terms are reviewed.
AGVARPRED_ENABLE_LIVE_PREDICTION=false
AGVARPRED_ALPHA_TERMS_REVIEWED=false

# Set these only through a local untracked .env or deployment secret manager.
# ALPHAGENOME_API_KEY=
# GNOMAD_VCF=/path/to/gnomad.exomes.r2.1.1.sites.liftover_grch38.vcf.bgz

# Comma-separated allowed frontend origins. Configure production origins explicitly.
AGVARPRED_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
